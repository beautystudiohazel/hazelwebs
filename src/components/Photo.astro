---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import beauty from '../assets/beauty.jpg';
import makeup from '../assets/makeup.jpg';
import haircut from '../assets/haircut.jpg';
import mockupHero from '../assets/mockup-hero.png';
import owner from '../assets/owner.jpg';
import hairWork2 from '../assets/hair-work-2.jpg';
interface Props { kind?: 'portrait' | 'beauty' | 'makeup' | 'haircut' | 'mockupHero' | 'owner' | 'hairWork2'; eager?: boolean; class?: string; }
const { kind = 'portrait', eager = false, class: className = '' } = Astro.props;
const photos = {
  portrait: { src: portrait, alt: 'Portrait with softly styled hair' },
  beauty: { src: beauty, alt: 'Facial mask being applied' },
  makeup: { src: makeup, alt: 'Makeup and cosmetics arranged together' },
  haircut: { src: haircut, alt: 'Softly styled hair' },
  mockupHero: { src: mockupHero, alt: 'Portrait with softly styled hair' },
  owner: { src: owner, alt: 'Portrait of the studio owner' },
  hairWork2: { src: hairWork2, alt: 'Long dark hair photographed in a salon' },
};
---
<Image src={photos[kind].src} alt={photos[kind].alt} class={className} widths={[400, 700, 1000, 1500]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
