---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import BookingLink from '../components/BookingLink.astro';
import { site } from '../data/site';
---
<Layout title="About & Contact" description="Meet Hazel Beauty Studio in Bolingbrook, find studio details, and book an appointment or contact Hazel directly.">
  <section class="section about-intro">
    <div>
      <p class="eyebrow">ABOUT HAZEL</p>
      <h1>A local studio.<br /><em>A personal touch.</em></h1>
      <p>Hazel Beauty Studio brings hair, skin care, waxing, makeup, and henna services together in Bolingbrook. Whether you’re planning a regular appointment or a celebration, Hazel welcomes you to get in touch.</p>
      <a class="text-link" href="/services/">Browse services &amp; prices <span aria-hidden="true">→</span></a>
    </div>
    <figure><div class="owner-portrait"><Photo kind="owner" eager /></div><figcaption>Hazel Beauty Studio owner</figcaption></figure>
  </section>
  <section class="section contact-section rose" id="contact">
    <div>
      <p class="eyebrow">VISIT OR GET IN TOUCH</p>
      <h2>Plan your<br /><em>studio visit.</em></h2>
      <p>Appointments are by booking. For questions or details about an event, contact Hazel directly.</p>
      <div class="contact-actions"><BookingLink /><a class="text-link email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">→</span></a></div>
      {!site.booksyUrl && <p class="small">An inquiry does not confirm an appointment.</p>}
    </div>
    <dl class="contact-details">
      <div><dt>PHONE</dt><dd>{site.phone ? <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a> : 'To be confirmed · please email us'}</dd></div>
      <div><dt>STUDIO LOCATION</dt><dd>{site.address || 'Address to be confirmed · email for visiting details'}{site.mapUrl && <a class="text-link" href={site.mapUrl}>Get directions <span aria-hidden="true">→</span></a>}</dd></div>
      <div><dt>BUSINESS HOURS</dt><dd class="preserve-lines">{site.hours || 'To be confirmed · please inquire by email'}</dd></div>
      {site.instagramUrl && <div><dt>INSTAGRAM</dt><dd><a class="text-link" href={site.instagramUrl}>Find Hazel’s on Instagram <span aria-hidden="true">→</span></a></dd></div>}
    </dl>
  </section>
</Layout>
