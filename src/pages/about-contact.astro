---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import BookingLink from '../components/BookingLink.astro';
import { site } from '../data/site';
---
<Layout title="About & Contact" description="Get to know Hazel Beauty Studio, a studio offering hair, skin care, waxing, makeup, bridal styling, and henna. Book appointments online or email us with questions.">
  <section class="section about-intro"><div><p class="eyebrow">WELCOME TO HAZEL’S</p><h1>Beauty fits<br /><em>into your life.</em></h1><p>Hazel Beauty Studio is a beauty studio offering haircuts, styling, color, skin care, waxing, and makeup, along with bridal styling and henna party bookings.</p><p>Whether you’re planning a regular trim or getting ready for a celebration, explore our service menu and contact us to discuss your visit.</p>{site.logoPath && <img class="full-logo" src={site.logoPath} alt="Hazel Beauty Studio original logo" />}<a class="text-link" href="/services/">Find your next service <span aria-hidden="true">→</span></a></div><figure><Photo kind="owner" eager /><figcaption>Hazel Beauty Studio owner</figcaption></figure></section>
  <section class="section contact-section rose" id="contact"><div><p class="eyebrow">SAY HELLO</p><h2>We’d love to<br /><em>hear from you.</em></h2><p>{site.booksyUrl ? 'Book appointments online. For service questions or event inquiries, email the studio.' : 'For appointments, service questions, or event inquiries, contact the studio by email.'}</p><a class="text-link email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">→</span></a><div class="contact-booking"><BookingLink /></div>{!site.booksyUrl && <p class="small">Your appointment is confirmed directly with the studio after your inquiry.</p>}</div><dl class="contact-details"><div><dt>PHONE</dt><dd>{site.phone ? <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a> : 'To be confirmed · please email us'}</dd></div><div><dt>STUDIO LOCATION</dt><dd>{site.address || 'Address to be confirmed · email for visiting details'}{site.mapUrl && <a class="text-link" href={site.mapUrl}>Get directions <span aria-hidden="true">→</span></a>}</dd></div><div><dt>BUSINESS HOURS</dt><dd class="preserve-lines">{site.hours || 'To be confirmed · please inquire by email'}</dd></div>{site.instagramUrl && <div><dt>INSTAGRAM</dt><dd><a class="text-link" href={site.instagramUrl}>Find Hazel’s on Instagram <span aria-hidden="true">→</span></a></dd></div>}</dl></section>
</Layout>
