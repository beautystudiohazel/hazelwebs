---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import BookingLink from '../components/BookingLink.astro';
import { site } from '../data/config';
---
<Layout title="Hair, skin & occasion beauty" description="Haircuts, color, facials, waxing, bridal beauty, and henna party bookings at Hazel Beauty Studio in Bolingbrook. Browse prices and request an appointment.">
  <section class="wire-hero section">
    <div class="wire-hero-copy"><p class="eyebrow">Hair, skin &amp; occasion beauty in {site.city}</p><h1><span>A little refresh.</span> <span>Completely you.</span></h1><p>Cuts, color, facials, waxing, makeup, and henna at Hazel Beauty Studio.</p><div class="actions"><a class="button" href="/services/">Explore Services <span aria-hidden="true">→</span></a><BookingLink variant="link" /></div></div>
    <figure class="wire-hero-image"><Photo kind="mockupHero" eager /><figcaption>Editorial inspiration; this is not studio or client work.</figcaption></figure>
  </section>
  <section class="wire-section section services-overview" aria-labelledby="services-overview-title"><p class="eyebrow">THE STUDIO MENU</p><h2 id="services-overview-title">Choose what feels right.</h2><p class="overview-introduction">From everyday hair and skin care to a celebration look, explore the services available at Hazel Beauty Studio.</p><div class="services-overview-grid">
    <a class="services-overview-column" href="/services/#cuts"><span class="eyebrow">01 / HAIR</span><h3>Hair, your way.</h3><p class="overview-summary">Cuts, styling, color and specialty treatments.</p><span class="text-link">Explore hair <span aria-hidden="true">→</span></span></a>
    <a class="services-overview-column" href="/services/#skin-care"><span class="eyebrow">02 / SKIN</span><h3>Time for skin.</h3><p class="overview-summary">Facials and skin-focused care.</p><span class="text-link">Explore skin care <span aria-hidden="true">→</span></span></a>
    <a class="services-overview-column" href="/services/#waxing"><span class="eyebrow">03 / WAXING</span><h3>Small details.</h3><p class="overview-summary">Face and body waxing.</p><span class="text-link">Explore waxing <span aria-hidden="true">→</span></span></a>
    <a class="services-overview-column" href="/bridal-events/"><span class="eyebrow">04 / OCCASIONS</span><h3>Make it a moment.</h3><p class="overview-summary">Bridal beauty, party makeup and henna bookings.</p><span class="text-link">Explore occasions <span aria-hidden="true">→</span></span></a>
  </div><a class="text-link overview-all" href="/services/">See all services &amp; prices<span aria-hidden="true">→</span></a></section>
  <section class="wire-event" aria-labelledby="occasion-title">
    <div class="wire-event-intro">
      <p class="eyebrow">Bridal · Party Makeup · Henna</p>
      <h2 id="occasion-title">For your next <em>celebration.</em></h2>
      <p>Explore hair, makeup, and henna services for your occasion.</p>
    </div>
    <div class="wire-event-details">
      <ul aria-label="Occasion services">
        <li>Bridal makeup</li>
        <li>Bridal hairstyling</li>
        <li>Party makeup</li>
        <li>Henna party bookings</li>
      </ul>
      <a class="text-link" href="/bridal-events/">Explore bridal &amp; events <span aria-hidden="true">→</span></a>
    </div>
  </section>
  {site.showRealWork && <section class="wire-real-work section" id="work" aria-labelledby="real-work-title">
    <div><p class="eyebrow">OUR WORK</p><h2 id="real-work-title">A look from the salon.</h2></div>
    <figure><Photo kind="hairWork2" /><figcaption>Hair work at Hazel Beauty Studio.</figcaption></figure>
  </section>}
  <section class="home-booking section" aria-labelledby="home-booking-title"><div><p class="eyebrow">YOUR NEXT VISIT</p><h2 id="home-booking-title">A little time for you.</h2><p>Appointments are by booking. Find studio details or get in touch if you have a question.</p></div><div class="home-booking-actions"><BookingLink /><a class="text-link" href="/about-contact/#contact">Contact &amp; studio details <span aria-hidden="true">→</span></a></div></section>
</Layout>
