---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { eventInquiry, site } from '../data/site';
import { categories, priceLabel } from '../data/services';
const events = categories.find(category => category.id === 'makeup-events')!;
---
<Layout title="Bridal & Events" description="Inquire about bridal makeup, bridal hairstyles, party makeup, and henna party bookings at Hazel Beauty Studio. Contact the studio for pricing and details.">
  <section class="event-hero"><div class="section"><p class="eyebrow">BRIDAL & EVENTS</p><h1>For the moments<br /><em>you’ll remember.</em></h1><p>A wedding. A party. A reason to bring everyone together.<br />Let’s talk about the beauty details for your celebration.</p><a class="button" href={eventInquiry}>Inquire about your occasion <span aria-hidden="true">→</span></a></div><Photo kind="makeup" eager /></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">YOUR OCCASION, YOUR LOOK</p><h2>Getting ready starts here.</h2></div></div><div class="event-services">{events.services.map((service, index) => <article><span class="eyebrow">0{index + 1}</span><h3>{service.name}</h3><p>{service.eventDescription || 'Contact us to discuss this service.'}</p><span class="price-note">{priceLabel(service)}</span></article>)}</div></section>
  <section class="section event-inquiry rose"><div><p class="eyebrow">TELL US WHAT YOU’RE PLANNING</p><h2>Start with a conversation.</h2><p>In your email, share your occasion, preferred date, and the services you’re interested in. We’ll discuss availability, pricing, and the details with you directly.</p><p class="small">Sending an inquiry does not reserve a date or confirm a booking.</p></div><div><a class="button" href={eventInquiry}>Email your event inquiry <span aria-hidden="true">→</span></a><a class="email" href={`mailto:${site.email}`}>{site.email}</a>{site.phone && <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>}</div></section>
</Layout>
